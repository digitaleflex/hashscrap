# Copy to hashscrap.toml and edit for your authorized sources.
# Do not put API keys or other secrets in this file.

[limits]
max_pages_per_source = 1000
max_depth = 5
max_concurrency = 16
max_response_bytes = 5000000

[[sources]]
id = "example-public-site"
name = "Example public website"
kind = "website"
base_url = "https://example.org"
enabled = false

[sources.limits]
timeout_seconds = 15
max_pages = 100
max_depth = 2
concurrency = 4
requests_per_second = 1.0
max_response_bytes = 2000000
max_retries = 2
